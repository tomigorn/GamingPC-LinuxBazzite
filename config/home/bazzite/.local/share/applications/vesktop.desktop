[Desktop Entry]
# Not a menu entry. KWin resolves a Wayland window's app_id straight to
# "<app_id>.desktop" and has no StartupWMClass fallback, so without this file
# Vesktop's windows (app_id=vesktop) get no icon in Alt+Tab / the task switcher.
# NoDisplay keeps it out of the menu; StartupWMClass is deliberately omitted so
# the Plasma task manager still matches windows to dev.vencord.Vesktop.desktop.
Type=Application
Name=Discord / Vesktop
Icon=dev.vencord.Vesktop
Exec=/usr/bin/flatpak run --branch=stable --arch=x86_64 --command=startvesktop --file-forwarding dev.vencord.Vesktop @@u %U @@
Terminal=false
NoDisplay=true
Categories=Network;
