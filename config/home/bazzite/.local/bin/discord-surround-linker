#!/usr/bin/python3
"""Keep surround apps fully audible in Vesktop screen-share streams.

venmic links only FL/FR of a captured app into vencord-screen-share. For every app whose FL is captured and which also has surround ports, link those ports into discord_surround_downmix, and link the downmix into the capture. Links for apps that are no longer captured are removed again. Follows the graph through one long-lived `pw-dump --monitor` instead of polling.
"""
import json
import subprocess
import time

CAPTURE = "vencord-screen-share"
DOWNMIX_IN = "discord_surround_downmix"
DOWNMIX_OUT = "discord_surround_downmix_out"
SURROUND = ("FC", "SL", "SR", "RL", "RR")


class BatchDecoder:
    def __init__(self):
        self.buf = ""
        self.dec = json.JSONDecoder()

    def feed(self, text):
        self.buf += text
        out = []
        while True:
            s = self.buf.lstrip()
            if not s:
                self.buf = ""
                return out
            try:
                obj, end = self.dec.raw_decode(s)
            except ValueError:
                self.buf = s
                return out
            out.append(obj)
            self.buf = s[end:]


def apply_batch(state, batch):
    for o in batch:
        if o.get("info") is None:
            state.pop(o["id"], None)
        else:
            state[o["id"]] = o


def graph(state):
    nodes, ports, links = {}, {}, set()
    for o in state.values():
        t, info = o.get("type", ""), o.get("info") or {}
        props = info.get("props") or {}
        if t.endswith(":Node"):
            nodes[o["id"]] = props.get("node.name")
        elif t.endswith(":Port"):
            ports[o["id"]] = (props.get("node.id"), props.get("port.direction"), props.get("audio.channel"))
        elif t.endswith(":Link"):
            links.add((info.get("output-port-id"), info.get("input-port-id")))
    return nodes, ports, links


def port(ports, node, direction, channel):
    for pid, (nid, d, ch) in ports.items():
        if nid == node and d == direction and ch == channel:
            return pid
    return None


def plan(state):
    nodes, ports, links = graph(state)
    by_name = {}
    for nid, name in nodes.items():
        by_name.setdefault(name, []).append(nid)
    captures = by_name.get(CAPTURE, [])
    dm_in = (by_name.get(DOWNMIX_IN) or [None])[0]
    dm_out = (by_name.get(DOWNMIX_OUT) or [None])[0]
    if dm_in is None or dm_out is None:
        return set(), set()

    capture_in = {port(ports, c, "in", ch) for c in captures for ch in ("FL", "FR")} - {None}
    captured = {ports[a][0] for a, b in links if b in capture_in and a in ports} - {dm_out}

    wanted = set()
    for app in captured:
        for ch in SURROUND:
            src, dst = port(ports, app, "out", ch), port(ports, dm_in, "in", ch)
            if src and dst:
                wanted.add((src, dst))
    if wanted:
        for c in captures:
            for ch in ("FL", "FR"):
                src, dst = port(ports, dm_out, "out", ch), port(ports, c, "in", ch)
                if src and dst:
                    wanted.add((src, dst))

    dm_inputs = {pid for pid, p in ports.items() if p[0] == dm_in and p[1] == "in"}
    drop = {(a, b) for a, b in links if b in dm_inputs and (a, b) not in wanted}
    return wanted - links, drop


def act(state):
    add, drop = plan(state)
    for a, b in add:
        subprocess.run(["pw-link", str(a), str(b)], capture_output=True)
    for a, b in drop:
        subprocess.run(["pw-link", "-d", str(a), str(b)], capture_output=True)


def follow():
    proc = subprocess.Popen(["pw-dump", "--monitor", "--no-colors"], stdout=subprocess.PIPE, text=True, bufsize=1)
    state, dec, pending = {}, BatchDecoder(), []
    for line in proc.stdout:
        pending.append(line)
        if not line.startswith("]"):
            continue
        batches = dec.feed("".join(pending))
        pending = []
        for batch in batches:
            apply_batch(state, batch)
        if batches:
            act(state)
    return proc.wait()


def main():
    while True:
        try:
            print(f"pw-dump exited ({follow()})", flush=True)
        except Exception as e:
            print(f"monitor failed: {e}", flush=True)
        time.sleep(2)


if __name__ == "__main__":
    main()
